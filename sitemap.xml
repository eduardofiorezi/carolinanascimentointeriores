---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.pages | where: 'layout', 'default' %}
  {% assign projects = site.pages | where: 'layout', 'project' %}
  {% assign indexable = pages | concat: projects | sort: 'url' %}
  {% for page in indexable %}
    {% unless page.noindex %}
  <url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>
    {% endunless %}
  {% endfor %}
</urlset>
